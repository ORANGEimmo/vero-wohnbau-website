# VERO Wohnbau — Caddy Site-Config (Source of Truth)
#
# Diese Datei ist die versionierte Quelle der Caddy-Konfiguration für vero-wohnbau.de.
# Sie wird vom Deploy-Workflow (.github/workflows/deploy.yml) auf den VPS nach
#   /etc/caddy/conf.d/vero-wohnbau.caddy
# kopiert; die Haupt-Caddyfile bindet sie via `import /etc/caddy/conf.d/*.caddy` ein.
# Nach dem Kopieren wird Caddy per `caddy reload` (Admin-API, kein sudo nötig) neu geladen.
#
# Siehe deploy/README.md für Details.

www.vero-wohnbau.de {
	redir https://vero-wohnbau.de{uri} permanent
}

vero-wohnbau.de {
	root * /var/www/vero-wohnbau
	encode zstd gzip

	# Statische Astro-Ausgabe (directory-Format): /seite -> /seite/index.html auflösen.
	# WICHTIG: NICHT `/index.html` als Fallback verwenden — das liefert für jede
	# Unterseite die Startseite aus (SPA-Fallback-Bug, behoben 2026-05-27).
	try_files {path} {path}/index.html
	file_server

	# Gebrandete 404-Seite (aus src/pages/404.astro -> dist/404.html)
	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}
}
