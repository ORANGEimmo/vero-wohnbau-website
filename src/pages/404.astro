---
import Layout from "../layouts/Layout.astro";

const quickLinks = [
  { href: "/projekte", label: "Projekte" },
  { href: "/ueber-uns", label: "Über uns" },
  { href: "/kontakt", label: "Kontakt" },
];
---

<Layout title="Seite nicht gefunden — VERO Wohnbau" headerVariant="light">
  <section
    class="relative flex items-center min-h-[88vh] overflow-hidden"
    style="background: var(--color-tann-deep); color: var(--color-cream);"
  >
    <div class="ct-wide w-full py-40">
      <div class="grid lg:grid-cols-12 gap-y-14 items-end">
        <div class="lg:col-span-8">
          <p class="eyebrow" style="color: var(--color-olive-bright);" data-reveal>
            Fehler 404
          </p>
          <h1
            class="font-display text-balance mt-6"
            style="color: var(--color-cream); font-weight: 200; line-height: 0.92; font-size: clamp(2.75rem, 8vw, 6rem);"
            data-reveal
            data-reveal-delay="120"
          >
            Diese Seite gibt es
            <span class="block italic" style="color: var(--color-olive-bright); font-weight: 300;">
              nicht.
            </span>
          </h1>
        </div>

        <div class="lg:col-span-4 lg:pl-8" data-reveal data-reveal-delay="300">
          <p
            class="text-base leading-relaxed mb-8"
            style="color: color-mix(in oklab, var(--color-cream) 88%, transparent);"
          >
            Vielleicht wurde sie verschoben, umbenannt — oder hat nie existiert.
            Zurück auf festen Grund:
          </p>
          <a href="/" class="btn btn-light">Zur Startseite</a>

          <nav class="mt-10 flex flex-wrap gap-x-6 gap-y-3">
            {quickLinks.map((item) => (
              <a
                href={item.href}
                class="text-sm tracking-wide link-underline"
                style="color: color-mix(in oklab, var(--color-cream) 72%, transparent);"
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </div>
    </div>
  </section>
</Layout>
