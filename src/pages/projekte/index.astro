---
import Layout from "../../layouts/Layout.astro";
import { projekte } from "../../data/projekte";
---

<Layout title="Projekte — VERO Wohnbau" description="Aktuelle Bauprojekte von VERO Wohnbau im Berchtesgadener Land." headerVariant="light">

  {/* ────────── HERO ────────── */}
  <section class="relative h-[70svh] min-h-[520px] overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/assets/berchtesgaden.webp"
        alt="Berchtesgaden mit dem Watzmann im Herbst"
        class="w-full h-full object-cover ken-burns"
      />
      <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(26,36,26,0.3) 0%, rgba(26,36,26,0.45) 50%, rgba(26,36,26,0.85) 100%);"></div>
    </div>

    <div class="relative z-10 h-full flex flex-col justify-end pb-20 md:pb-28">
      <div class="ct-wide grid lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-9">
          <p class="eyebrow mb-6" style="color: var(--color-olive-bright);">— Index 01</p>
          <h1 class="text-balance" style="color: var(--color-cream); font-weight: 200;" data-reveal>
            Häuser, die zur<br />
            <em style="color: var(--color-olive-bright); font-weight: 300;">Landschaft</em> gehören.
          </h1>
        </div>
        <div class="lg:col-span-3 lg:pl-8" data-reveal data-reveal-delay="200">
          <p class="text-base leading-relaxed" style="color: color-mix(in oklab, var(--color-cream) 88%, transparent);">
            Jedes Projekt ist ein eigener Ort, eine eigene Geschichte.
            Hier finden Sie unsere aktuellen und kommenden Bauvorhaben.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ────────── PROJECT LIST — large editorial spreads ────────── */}
  {projekte.map((p, i) => {
    const flip = i % 2 === 1;
    return (
      <section
        class="relative"
        style={`background: ${i % 2 === 0 ? "var(--color-cream)" : "var(--color-paper)"}; border-top: 1px solid var(--color-line);`}
      >
        <div class="ct-wide py-20 md:py-32">
          <div class={`grid lg:grid-cols-12 gap-8 lg:gap-16 items-center ${flip ? "lg:[&>:nth-child(1)]:order-2" : ""}`}>
            <a href={`/projekte/${p.slug}`} class="block lg:col-span-7 group" data-reveal>
              <div class="relative overflow-hidden aspect-[4/3]">
                <img
                  src={p.hero}
                  alt={p.name}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
                  loading="lazy"
                  data-reveal-image
                />
                <div class="absolute top-6 left-6 flex items-center gap-3 text-xs font-mono uppercase tracking-[0.22em]" style="color: var(--color-cream); mix-blend-mode: difference;">
                  <span class="inline-block w-2 h-2" style={`background: ${p.status === 'In Bau' ? 'var(--color-olive-bright)' : 'rgba(240,237,228,0.7)'};`}></span>
                  {p.status}
                </div>
              </div>
            </a>

            <div class="lg:col-span-5" data-reveal data-reveal-delay="200">
              <p class="font-mono text-xs uppercase tracking-[0.22em] mb-4" style="color: var(--color-olive);">
                — Projekt 0{i + 1}
              </p>
              <h2 style="font-size: clamp(2.5rem, 5vw, 4rem);">
                {p.name}
              </h2>
              <p class="mt-3 text-base font-mono uppercase tracking-[0.18em]" style="color: var(--color-olive);">
                {p.ort} · {p.jahr}
              </p>

              <div class="mt-10 h-px w-12" style="background: var(--color-olive);"></div>

              <p class="mt-10 leading-relaxed text-lg" style="color: var(--color-salbei);">
                {p.beschreibung}
              </p>

              <a href={`/projekte/${p.slug}`} class="btn mt-12">Projekt ansehen</a>
            </div>
          </div>
        </div>
      </section>
    );
  })}

  {/* ────────── COMING SOON STRIPE ────────── */}
  <section class="relative" style="background: var(--color-tann); color: var(--color-cream);">
    <div class="ct-wide py-24 md:py-32 grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow mb-6" style="color: var(--color-olive-bright);">Auf der Schreibtischplatte</p>
        <h2 class="text-balance" style="color: var(--color-cream);">
          Weitere Projekte sind in <em style="color: var(--color-olive-bright); font-weight: 300;">Vorbereitung</em>.
        </h2>
      </div>
      <div class="lg:col-span-5 lg:text-right" data-reveal data-reveal-delay="200">
        <p class="text-lg leading-relaxed mb-8 lg:ml-auto max-w-md" style="color: color-mix(in oklab, var(--color-cream) 80%, transparent);">
          Wenn Sie früh über kommende Projekte informiert werden möchten — sagen
          Sie uns Bescheid.
        </p>
        <a href="/kontakt?betreff=Newsletter" class="btn btn-light">Auf Liste setzen</a>
      </div>
    </div>
  </section>
</Layout>
