---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  hideHeader?: boolean;
  headerVariant?: "light" | "dark";
}

const {
  title = "VERO Wohnbau — wahr · echt · wirklich",
  description = "VERO Wohnbau realisiert Immobilien im Berchtesgadener Land. Ehrlich gebaut, mit natürlichen Materialien, regional verwurzelt.",
  hideHeader = false,
  headerVariant = "dark",
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2a382a" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@300;400;500;600;700&family=Inter+Tight:wght@200;300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-cream)] text-[var(--color-ink)]">
    {/* film grain — atmosphere only */}
    <div class="grain-overlay" aria-hidden="true"></div>

    {!hideHeader && <Header variant={headerVariant} />}
    <main class="flex-1 relative z-[2]">
      <slot />
    </main>
    <Footer />

    {/* Scroll reveal observer */}
    <script>
      const setup = () => {
        const els = document.querySelectorAll(
          "[data-reveal], [data-reveal-image], [data-reveal-line]"
        );
        if (!els.length) return;

        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        els.forEach((el) => io.observe(el));
      };

      // Run on first load + after every Astro view-transition
      setup();
      document.addEventListener("astro:page-load", setup);
    </script>
  </body>
</html>
